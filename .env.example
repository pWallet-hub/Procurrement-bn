# Copy to .env. docker-compose reads this file.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

DATABASE_URL=postgres://afs:afs_dev_password@postgres:5432/afs
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# false in dev so seeded users can sign in without an authenticator app
TOTP_REQUIRED=false

# storage: "s3" (SeaweedFS in docker) or "local" disk
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=/data/files
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=afs-files
S3_ACCESS_KEY=afsstorage
S3_SECRET_KEY=afsstorage_dev_secret

# mail: dev uses Mailpit (UI on http://localhost:8025). Production: Google Workspace SMTP relay.
MAIL_FROM="AfS Procurement <procurement@afs.local>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Initial administrator, created on first start (required when NODE_ENV=production).
# The admin signs in, changes this password under Profile, then invites everyone else (Admin > Users).
# ADMIN_FORCE_RESET=true resets the password of this account on the next start (lost password recovery).
ADMIN_EMAIL=admin@afs.local
ADMIN_PASSWORD=Passw0rd!dev
ADMIN_NAME="System Administrator"
ADMIN_FORCE_RESET=false

# SEED_ON_START loads roles, permissions and form templates (also needed in production); demo users/data only load outside production
SEED_ON_START=true
SEED_PASSWORD=Passw0rd!dev

# host ports (change when something else on your machine already uses the default)
API_PORT=3000
POSTGRES_PORT=5432
S3_PORT=8333
MAILPIT_PORT=8025
